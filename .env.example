# ─── LiveKit (Video Media Server) ────────────────────────────────────────────
# Option A: LiveKit Cloud (managed, free tier) → https://livekit.io/cloud
# Option B: Self-hosted LiveKit binary on VPS
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ─── Supabase (Database, Auth, Storage) ──────────────────────────────────────
# Create a free project at https://supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ─── AI Question Generation (Optional) ───────────────────────────────────────
# Free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ─── Recording Storage (Optional, Phase 6) ───────────────────────────────────
# Cloudflare R2 (free tier for storage)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=jumbo-recordings
R2_PUBLIC_URL=https://recordings.your-domain.com

# ─── API Server ───────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# CORS: comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Must be prefixed with VITE_ to be exposed to client
VITE_API_URL=http://localhost:3001
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
