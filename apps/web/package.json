{
  "name": "@jumbo/web",
  "version": "0.1.0",
  "private": true,
  "description": "Jumbo App — React PWA frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm --filter @jumbo/shared build && pnpm --filter @jumbo/questions build && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@jumbo/shared": "workspace:*",
    "@jumbo/questions": "workspace:*",
    "@livekit/components-react": "^2.6.0",
    "@livekit/components-styles": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "canvas-confetti": "^1.9.0",
    "framer-motion": "^11.5.0",
    "livekit-client": "^2.6.0",
    "lucide-react": "^0.454.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.28.0",
    "socket.io-client": "^4.8.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0"
  }
}
