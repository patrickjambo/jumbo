# ─── Jumbo Web (Vite) — Environment Variables ────────────────────────────────
# Copy this file to .env.local for local development.
# For Vercel deployment, add these as Environment Variables in the Vercel dashboard.

# ── REQUIRED for production ───────────────────────────────────────────────────
# URL of the Jumbo API server (Render, Railway, VPS, etc.)
# In development this can be left empty — Vite proxy handles /socket.io automatically.
# In production (Vercel + Render) this MUST be set or participants won't see each other.
VITE_API_URL=https://jumbo-api.onrender.com

# ── Optional: LiveKit Cloud (for SFU-based meetings with 10+ participants) ────
# Get from https://cloud.livekit.io — leave blank to use the built-in WebRTC P2P
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# ── Optional: TURN server (for users behind symmetric NAT / strict firewalls) ─
# Without TURN, ~10-15% of P2P connections may fail (corporate networks, mobile).
# Free TURN: https://www.metered.ca/tools/openrelay/ or self-host coturn.
VITE_TURN_URL=turn:openrelay.metered.ca:80
VITE_TURN_USER=openrelayproject
VITE_TURN_CRED=openrelayproject

