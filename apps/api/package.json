{
  "name": "@jumbo/api",
  "version": "0.1.0",
  "private": true,
  "description": "Jumbo API — Fastify + Socket.IO + LiveKit token server",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --build && tsc-alias",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@jumbo/questions": "workspace:*",
    "@jumbo/shared": "workspace:*",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.0.0",
    "livekit-server-sdk": "^2.6.0",
    "socket.io": "^4.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "socket.io-client": "^4.8.4",
    "tsc-alias": "^1.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
